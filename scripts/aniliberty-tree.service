[Unit]
Description=Rebuild AniLiberty series/movie symlink trees for Jellyfin
# Wait for network/remote mounts; for archives on NFS/SMB add RequiresMountsFor=<source> (install.sh does it).
After=network-online.target remote-fs.target

[Service]
Type=oneshot
# The user Jellyfin runs as, so it can read the trees.
User=jellyfin
# Paths and options: see aniliberty-tree.conf.
EnvironmentFile=/etc/aniliberty-tree.conf
ExecStart=/usr/bin/python3 /usr/local/bin/aniliberty-tree.py
Nice=10
IOSchedulingClass=idle
