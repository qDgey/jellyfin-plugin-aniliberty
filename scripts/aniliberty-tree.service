[Unit]
Description=Rebuild AniLiberty series/movie symlink trees for Jellyfin
RequiresMountsFor=/media/aniliberty

[Service]
Type=oneshot
# Run as the user Jellyfin runs as, so it can read the trees.
User=jellyfin
Environment=ANILIBERTY_SOURCE=/media/aniliberty
Environment=ANILIBERTY_SERIES=/srv/aniliberty-series
Environment=ANILIBERTY_MOVIES=/srv/aniliberty-movies
ExecStart=/usr/bin/python3 /usr/local/bin/aniliberty-tree.py
